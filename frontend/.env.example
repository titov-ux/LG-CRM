VITE_API_BASE_URL=/api/v1
VITE_USE_MOCKS=true
# CSV-список доменов, MSW которых отключён — фронт пойдёт в реальный API.
# Доменом считается первый сегмент пути: users, vacancies, candidates, comments,
# matches, notifications, audit, analytics, permissions-matrix, clients, contacts, auth, files.
# Пример (после Этапа 6): VITE_DISABLED_HANDLERS=auth,users,permissions-matrix,clients,contacts,vacancies,candidates,matches,comments,audit,files
# Замечание: домен files отсутствует в MSW (handlers нет) — фронт всегда ходит в реальный API,
# так что добавлять его в DISABLED_HANDLERS не обязательно, но не повредит.
VITE_DISABLED_HANDLERS=
VITE_APP_TITLE=ЛГ Интеграция · SaaS
VITE_SENTRY_DSN=
