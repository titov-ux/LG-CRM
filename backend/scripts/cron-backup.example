# /etc/cron.d/crm-lg-backup
# Ежедневный бэкап БД в Yandex Object Storage.
#  - 01:00 UTC = 04:00 МСК (минимум нагрузки, recovery-drill уходит позже).
#  - Cron подхватывает секреты из .env.prod через `set -a && . .env.prod && set +a`.
#  - BACKUP_S3_PREFIX (prod | staging) тоже берётся из .env.prod и определяет,
#    в какой папке бакета лежат дампы этого контура.

0 1 * * * root cd /opt/crm-lg && set -a && . .env.prod && set +a && /usr/bin/env bash backend/scripts/backup_db.sh >> /var/log/crm-lg-backup.log 2>&1
