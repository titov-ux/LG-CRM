# Production env (заполняется при выкатке staging/prod).
# Положить в корень репозитория как .env.prod, не коммитить.

# ── Окружение ──
# Допустимые значения (см. app/core/config.py): dev | staging | prod.
# НЕ "production" — pydantic упадёт с literal_error.
ENV=prod
DEBUG=false
API_V1_PREFIX=/api/v1

# ── Postgres ──
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=crm_lg
DATABASE_URL=postgresql+asyncpg://crm:CHANGE_ME@postgres:5432/crm_lg

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT ──
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ── CORS ──
# В prod-фронт раздаётся тем же nginx (same-origin), но если фронт где-то отдельно — добавить домен.
# staging: ["https://staging.lachevsky.ru"]
# prod:    ["https://crm.lachevsky.ru"]
CORS_ORIGINS=["https://crm.lachevsky.ru"]

# ── Сид-админ ──
ADMIN_EMAIL=admin@lachevsky.ru
ADMIN_PASSWORD=CHANGE_ME

# ── Frontend / приглашения ──
# Базовый URL фронта — используется в письме-приглашении (`{APP_BASE_URL}/invite/{token}`).
# staging: https://staging.lachevsky.ru
# prod:    https://crm.lachevsky.ru  ← НЕ голый lachevsky.ru, прод живёт на поддомене
APP_BASE_URL=https://crm.lachevsky.ru
INVITE_TTL_DAYS=7

# ── SMTP (Yandex 360 для бизнеса) ──
# Без SMTP_HOST/SMTP_USER отправка деградирует в лог, и в ответе POST /users
# приходит inviteUrl — фронт покажет «Не удалось отправить письмо, скопируйте ссылку».
# Ящик noreply@lachevsky.group уже используется на staging — EULA принят, отдельной
# активации не нужно (см. memory crm-lg-invite-flow).
# ВАЖНО: SMTP_PASSWORD — это «пароль приложения» из Яндекс ID, НЕ обычный пароль.
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=noreply@lachevsky.group
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM=noreply@lachevsky.group
SMTP_FROM_NAME=ЛГ Интеграция
SMTP_TIMEOUT_SECONDS=15

# ── S3 (Yandex Object Storage) ──
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
# Files-bucket — отдельный для prod / staging (см. infra/terraform/*.tfvars).
S3_BUCKET=crm-lg-prod-files
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
FILE_MAX_BYTES=26214400

# ── Sentry ──
# Если пусто — Sentry-инициализация будет пропущена.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── hh.ru OAuth (импорт резюме через /integrations/hh + расширение Candidate Capture) ──
# Регистрируется в карточке приложения на https://dev.hh.ru/admin.
# Redirect URI должен ТОЧНО совпадать с тем, что указан в карточке hh.
#   staging: https://staging.lachevsky.ru/settings/integrations/hh/callback
#   prod:    https://crm.lachevsky.ru/settings/integrations/hh/callback
# Без HH_CLIENT_ID/HH_CLIENT_SECRET кнопка «Подключить hh» в UI выдаст
# 503 hh_not_configured, импорт работать не будет.
HH_CLIENT_ID=CHANGE_ME
HH_CLIENT_SECRET=CHANGE_ME
HH_REDIRECT_URI=https://crm.lachevsky.ru/settings/integrations/hh/callback
# User-Agent обязателен для hh API — пиши контактный email команды.
HH_USER_AGENT=CRM-LG/1.0 (titovalexeys@gmail.com)

# ── Telegram-бот уведомлений ──
# 1) Создать бота через @BotFather → BOT_TOKEN и @username (без @).
# 2) Сгенерить секрет вебхука: openssl rand -hex 16
# Webhook регистрируется на старте. URL = TELEGRAM_WEBHOOK_URL, а если он пуст —
# {APP_BASE_URL}{API_V1_PREFIX}/integrations/telegram/webhook. Для prod это
# https://crm.lachevsky.ru/api/v1/integrations/telegram/webhook (нужен публичный https).
# Без TELEGRAM_BOT_TOKEN интеграция выключена (ничего не шлётся).
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_BOT_USERNAME=CHANGE_ME
TELEGRAM_WEBHOOK_SECRET=CHANGE_ME
# Оставить пустым → соберётся из APP_BASE_URL + API_V1_PREFIX (рекомендуется).
TELEGRAM_WEBHOOK_URL=
# ВАЖНО (РФ-хостинг): с egress-IP YC api.telegram.org заблокирован — прямой
# sendMessage падает по ConnectTimeout, уведомления не доходят. Нужен релей вне
# фильтра. Выбрать ОДИН из двух вариантов:
#  (а) Cloudflare Worker (бесплатно) — см. infra/telegram-relay/README.md:
#      TELEGRAM_API_BASE=https://crm-lg-tg-relay.<субдомен>.workers.dev
#  (б) SOCKS5-прокси на узле вне РФ:
#      TELEGRAM_API_PROXY=socks5://user:pass@host:port
# Пусто = идём напрямую (на prod в РФ работать НЕ будет).
TELEGRAM_API_BASE=
TELEGRAM_API_PROXY=

# ── AI-скрининг / stt-service (Этап 2) ──
# Backend ходит в stt по внутренней сети compose.
STT_URL=ws://stt:8765
SCREENING_MAX_DURATION_MIN=90
SCREENING_WS_HOLD_SEC=60
# STT_FAKE=1 — заглушка (лёгкий образ). Для Whisper: STT_FULL=1 при build + STT_FAKE=0.
STT_FAKE=1
STT_FULL=0
STT_MODEL=small
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_CPU_THREADS=4

# ── Бэкап БД (используется scripts/backup_db.sh + cron-backup) ──
# Бакет общий для prod и staging — разделяем префиксом окружения.
BACKUP_S3_BUCKET=crm-lg-staging-backups
BACKUP_S3_PREFIX=prod
BACKUP_RETENTION_DAYS=30
