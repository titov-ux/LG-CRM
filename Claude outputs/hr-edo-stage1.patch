+def _doc_type_or_422(code: str) -> DocType:
+    t = get_doc_type(code)
+    if t is None:
+        raise ApiError(status.HTTP_422_UNPROCESSABLE_ENTITY, "unknown_type", "Неизвестный тип документа")
+    return t
+
