# Шаблон переменных для prod-контура.
# Скопировать в prod.tfvars и заполнить (prod.tfvars в .gitignore — не коммитим).
#
# Применяется после: tofu workspace select prod
#   tofu plan  -var-file=prod.tfvars -out=prod.tfplan
#   tofu apply prod.tfplan

cloud_id  = "<yc-cloud-id>"
folder_id = "<yc-folder-id>"
zone      = "ru-central1-a"
vm_name   = "crm-lg-prod"

# Prod крупнее: 4 vCPU / 8 GB / 100 GB SSD. Подкрути под реальную нагрузку.
vm_cores     = 4
vm_memory_gb = 8
vm_disk_gb   = 100

# Тот же публичный SSH-ключ, что в staging.
ssh_public_key = "ssh-ed25519 AAAA... user@host"

# Files-бакет — глобально уникальное имя, отдельный от staging.
files_bucket = "crm-lg-prod-files"

# Бэкапы можно либо положить в отдельный бакет (например, crm-lg-prod-backups,
# create_backups_bucket=true), либо переиспользовать staging-бакет
# (имя из staging.tfvars + create_backups_bucket=false). Во втором случае
# обязательно задайте разный BACKUP_S3_PREFIX в .env.prod prod- и staging-контура,
# чтобы дампы не смешивались.
backups_bucket        = "crm-lg-staging-backups"
create_backups_bucket = false

# Боевой домен — используется в CORS files-бакета и в info-outputs.
domain = "crm.lachevsky.ru"
