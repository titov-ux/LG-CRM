# Окружение
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# База данных и кэш
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm_lg
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Сид-админ для первого запуска
ADMIN_EMAIL=admin@lg.ru
ADMIN_PASSWORD=change-me

# S3 (Yandex Object Storage) — заполняется на Этапе 6
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=crm-lg-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
FILE_MAX_BYTES=26214400

# YandexGPT — AI-распознавание брифа вакансии (POST /vacancies/parse-text).
# Yandex Cloud AI Studio, OpenAI-совместимый API. Без ключа эндпоинт вернёт 503 ai_unavailable.
# Получить ключ: AI Studio → Settings → API keys (роль ai.languageModels.user).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_MODEL=yandexgpt/rc
YANDEX_AI_TIMEOUT_SECONDS=30
YANDEX_AI_MAX_INPUT_CHARS=20000
