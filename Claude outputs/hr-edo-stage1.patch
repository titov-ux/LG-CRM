+
+      <Tabs value={tab} onValueChange={(v) => setTab(v as Tab)}>
+        <TabsList className="mb-3">
+          <TabsTrigger value="documents">Документы</TabsTrigger>
+          <TabsTrigger value="employees">Сотрудники</TabsTrigger>
