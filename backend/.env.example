# Окружение
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# База данных и кэш
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm_lg
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Сид-админ для первого запуска
ADMIN_EMAIL=admin@lg.ru
ADMIN_PASSWORD=change-me

# S3 (Yandex Object Storage) — заполняется на Этапе 6
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=crm-lg-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
FILE_MAX_BYTES=26214400

# YandexGPT — AI-распознавание брифа вакансии (POST /vacancies/parse-text).
# Yandex Cloud AI Studio, OpenAI-совместимый API. Без ключа эндпоинт вернёт 503 ai_unavailable.
# Получить ключ: AI Studio → Settings → API keys (роль ai.languageModels.user).
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_AI_BASE_URL=https://ai.api.cloud.yandex.net/v1
YANDEX_AI_MODEL=yandexgpt/rc
YANDEX_AI_TIMEOUT_SECONDS=30
YANDEX_AI_MAX_INPUT_CHARS=40000

# hh.ru OAuth (POST /integrations/hh + расширение Candidate Capture).
# Регистрируется на https://dev.hh.ru/admin. Redirect URI обязан совпадать
# с тем, что прописан в карточке приложения.
#   dev:     http://localhost:5173/settings/integrations/hh/callback
#   staging: https://staging.lachevsky.ru/settings/integrations/hh/callback
#   prod:    https://crm.lachevsky.ru/settings/integrations/hh/callback
HH_CLIENT_ID=
HH_CLIENT_SECRET=
HH_REDIRECT_URI=http://localhost:5173/settings/integrations/hh/callback
HH_USER_AGENT=CRM-LG/1.0 (titovalexeys@gmail.com)

# Telegram-бот уведомлений.
# 1) Создать бота через @BotFather → получить токен и @username.
# 2) Придумать любой секрет вебхука (для проверки заголовка от Telegram).
# Без TELEGRAM_BOT_TOKEN интеграция выключена (ничего не шлётся).
# Вебхук регистрируется на старте: TELEGRAM_WEBHOOK_URL или, если пуст,
# {APP_BASE_URL}{API_V1_PREFIX}/integrations/telegram/webhook (нужен публичный https —
# на localhost вебхук не поднять без туннеля, оставьте токен пустым для dev).
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=

# AI-скрининг / stt-service (Этап 2+)
# Dev compose: docker compose -f infra/docker-compose.dev.yml up -d stt
# STT_URL пустой = realtime-транскрипция выключена (запись в S3 всё равно работает).
STT_URL=ws://localhost:8765
SCREENING_MAX_DURATION_MIN=90
SCREENING_WS_HOLD_SEC=60
# Retention аудиозаписей (дни). 0 = не чистить. Celery beat 03:15 UTC.
SCREENING_AUDIO_RETENTION_DAYS=90
# Realtime-агент вопросов (Этап 4). Без YANDEX_API_KEY тики молча пропускаются.
SCREENING_AI_ENABLED=true
SCREENING_AI_DEBOUNCE_SEC=8
SCREENING_AI_MIN_INTERVAL_SEC=8
SCREENING_AI_MAX_CALLS_PER_SESSION=40
SCREENING_AI_MAX_FOLLOWUPS_PER_TICK=2
SCREENING_AI_MAX_FOLLOWUPS_PER_SESSION=8
SCREENING_AI_TRANSCRIPT_TAIL=24
# Пост-анализ отчёта (Этап 5). true = in-process после finish; false = Celery worker.
SCREENING_ANALYSIS_EAGER=true
