# DNS-конфиг CRM-LG. Скопировать в terraform.tfvars и заполнить.
# (terraform.tfvars под .gitignore — не коммитим)

cloud_id  = "<yc-cloud-id>"
folder_id = "<yc-folder-id>"
zone      = "ru-central1-a"

# Корневой домен с точкой в конце (FQDN).
domain = "lachevsky.ru."

# Поддомен staging (получится <staging_subdomain>.<domain>).
staging_subdomain = "staging"
# IP staging-VM. Берётся из `tofu output public_ip` в ../ (workspace 'staging').
staging_ip = "<staging-vm-ip>"

# Поддомен prod (по умолчанию "crm" → crm.lachevsky.ru).
# Пустая строка — запись пойдёт на корень домена.
prod_subdomain = "crm"
# IP prod-VM. Берётся из `tofu output public_ip` в ../ (workspace 'prod').
# Пока пусто — prod-recordset не создаётся.
prod_ip = ""
