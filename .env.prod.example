# Production env (заполняется при выкатке staging/prod).
# Положить в корень репозитория как .env.prod, не коммитить.

# ── Окружение ──
# prod | staging  — определяет SENTRY_ENVIRONMENT и BACKUP_S3_PREFIX по смыслу.
ENV=production
DEBUG=false
API_V1_PREFIX=/api/v1

# ── Postgres ──
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=crm_lg
DATABASE_URL=postgresql+asyncpg://crm:CHANGE_ME@postgres:5432/crm_lg

# ── Redis ──
REDIS_URL=redis://redis:6379/0

# ── JWT ──
JWT_SECRET=CHANGE_ME_TO_LONG_RANDOM_STRING
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# ── CORS ──
# В prod-фронт раздаётся тем же nginx (same-origin), но если фронт где-то отдельно — добавить домен.
# staging: ["https://staging.lachevsky.ru"]
# prod:    ["https://crm.lachevsky.ru"]
CORS_ORIGINS=["https://crm.lachevsky.ru"]

# ── Сид-админ ──
ADMIN_EMAIL=admin@lachevsky.ru
ADMIN_PASSWORD=CHANGE_ME

# ── S3 (Yandex Object Storage) ──
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
# Files-bucket — отдельный для prod / staging (см. infra/terraform/*.tfvars).
S3_BUCKET=crm-lg-prod-files
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
FILE_MAX_BYTES=26214400

# ── Sentry ──
# Если пусто — Sentry-инициализация будет пропущена.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# ── Бэкап БД (используется scripts/backup_db.sh + cron-backup) ──
# Бакет общий для prod и staging — разделяем префиксом окружения.
BACKUP_S3_BUCKET=crm-lg-staging-backups
BACKUP_S3_PREFIX=prod
BACKUP_RETENTION_DAYS=30
