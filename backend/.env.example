# Окружение
ENV=dev
DEBUG=true
API_V1_PREFIX=/api/v1

# База данных и кэш
DATABASE_URL=postgresql+asyncpg://crm:crm@localhost:5432/crm_lg
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET=change-me-in-prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Сид-админ для первого запуска
ADMIN_EMAIL=admin@lg.ru
ADMIN_PASSWORD=change-me

# S3 (Yandex Object Storage) — заполняется на Этапе 6
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=crm-lg-files
S3_ACCESS_KEY=
S3_SECRET_KEY=
FILE_MAX_BYTES=26214400
