+<!DOCTYPE html>
+<html lang="ru">
+<head>
+<meta charset="UTF-8">
+<title>{{ title | t }}{% if number %} № {{ number }}{% endif %} - {{ company.short | t }}</title>
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Golos+Text:wght@400;500;600;700&display=swap">
+<style>
+  :root {
+    --paper: #FFFFFF;
+    --ink: #14171A;
+    --accent: #0A47A9;
+    --muted: #5D6570;
+    --line: #E4E7EB;
+    --sans: 'Golos Text', 'Segoe UI', Arial, sans-serif;
+  }
+  * { margin: 0; padding: 0; box-sizing: border-box; }
+  @page { size: A4; margin: 16mm 17mm 18mm; }
+  html, body { background: var(--paper); }
+  body {
+    color: var(--ink);
+    font-family: var(--sans);
+    font-size: 13.5px;
+    line-height: 1.55;
+    -webkit-print-color-adjust: exact;
+    print-color-adjust: exact;
+  }
+  h1, h2, h3 { break-after: avoid; }
+  header {
+    display: flex;
+    justify-content: space-between;
+    align-items: center;
+    padding-bottom: 16px;
+    border-bottom: 3px solid var(--ink);
+  }
+  .brand { display: flex; align-items: center; gap: 10px; font-weight: 700; font-size: 15px; }
+  .brand svg { flex-shrink: 0; display: block; }
+  .doc-meta { text-align: right; font-size: 11.5px; color: var(--muted); line-height: 1.5; }
+  .draft {
+    margin-top: 14px;
+    padding: 8px 12px;
+    border: 1.5px dashed #B45309;
+    color: #92400E;
+    background: #FFFBEB;
+    font-size: 11px;
+    font-weight: 600;
+    letter-spacing: 0.02em;
+    text-align: center;
+  }
+  h1 { margin-top: 26px; font-weight: 600; font-size: 21px; line-height: 1.3; text-align: center; }
+  .subtitle { text-align: center; color: var(--muted); font-size: 12.5px; margin-top: 4px; }
+  .place-date { display: flex; justify-content: space-between; margin-top: 20px; font-size: 13px; }
+  h2 { font-weight: 600; font-size: 14.5px; margin: 20px 0 8px; }
+  p { margin: 6px 0; text-align: justify; }
+  ol.clauses { padding-left: 0; list-style: none; counter-reset: clause; }
+  ol.clauses > li { counter-increment: clause; margin: 5px 0; text-align: justify; }
+  ol.clauses > li::before { content: attr(data-n) " "; font-weight: 600; }
+  .terms { border-top: 1px solid var(--line); margin-top: 8px; }
+  .terms > div {
+    display: grid;
+    grid-template-columns: 210px 1fr;
+    gap: 14px;
+    padding: 7px 0;
+    border-bottom: 1px solid var(--line);
+    break-inside: avoid;
+  }
+  .terms dt { color: var(--muted); }
+  .terms dd { font-weight: 500; }
+  .signs {
+    margin-top: 34px;
+    display: grid;
+    grid-template-columns: 1fr 1fr;
+    gap: 36px;
+    break-inside: avoid;
+  }
+  .signs h3 { font-size: 13px; font-weight: 600; margin-bottom: 6px; }
+  .signs .req { font-size: 11.5px; color: var(--muted); line-height: 1.5; }
+  .signs .line { margin-top: 26px; border-top: 1px solid var(--ink); padding-top: 3px; font-size: 11px; color: var(--muted); }
+  .note { margin-top: 20px; font-size: 11px; color: var(--muted); }
+  .section h2 + p, .section h2 + ol { break-before: avoid; }
+  .page-break { break-before: page; }
+  /* Предпросмотр в браузере (iframe): поля листа, как в PDF. На печать не влияет. */
+  @media screen { body { max-width: 210mm; margin: 0 auto; padding: 14mm 16mm; } }
+</style>
+</head>
+<body>
+  <header>
+    <div class="brand">
+      <svg width="26" height="26" viewBox="0 0 37 37" fill="none" xmlns="http://www.w3.org/2000/svg" aria-label="Логотип">
+        <path d="M37 31.7143V37H0L0 0L5.28571 0L5.28571 31.7143L37 31.7143Z" fill="currentColor"/>
+        <path d="M10.5714 26.4286L10.5714 0L37 0V5.28571L15.8571 5.28571L15.8571 21.1429H31.7143V15.8571H21.1429V10.5714H37V26.4286L10.5714 26.4286Z" fill="currentColor"/>
+      </svg>
+      <span>{{ company.name | t }}</span>
+    </div>
+    <div class="doc-meta">
+      {{ title | t }}<br>
+      {% if number %}№ {{ number }}{% else %}№ присваивается при формировании{% endif %}
+    </div>
