+  {% else %}
+  <li data-n="1.1.">________________________________________________</li>
+  {% endfor %}
+</ol>
+
+<h2>2. Заключительные положения</h2>
+<ol class="clauses">
+  <li data-n="2.1.">Соглашение вступает в силу {{ f.effective_date | date_ru }} и является неотъемлемой частью трудового договора.</li>
+  <li data-n="2.2.">Остальные условия трудового договора не изменяются.</li>
+  <li data-n="2.3.">Соглашение составлено в форме электронного документа и подписано электронными подписями сторон (ч. 1, 4 ст. 22.3 ТК РФ).</li>
+</ol>
+
+{{ m.signs(company, employee) }}
+{% endblock %}
