+} from './statuses';
+
+type Tab = 'documents' | 'employees' | 'journal';
+
+export function HrDocsPage() {
+  const canManage = useCan('hr_edo:manage');
+  const [tab, setTab] = useState<Tab>('documents');
+  const [docId, setDocId] = useState<string | null>(null);
